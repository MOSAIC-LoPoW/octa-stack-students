 119:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 120:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_WRITE_IN_PROGRESS;
 121:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 122:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 123:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (aPageNr > MAX_PAGE_NUMBER)
 124:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 125:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_INVALID_PAGE_NR;
 126:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 127:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 128:../../../core/drivers/octa-flash/src/octa-flash.c ****     uint32_t newAddress = FIRST_FLASH_ADDRESS + aPageNr * (OCTA_FLASH_PAGE_SIZE);
 129:../../../core/drivers/octa-flash/src/octa-flash.c ****     mCurrentReadAddress = newAddress;

 107:../../../core/drivers/octa-flash/src/octa-flash.c **** /**
 108:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \brief    Sets the read and write address to the start of this page. The max value is defined
 109:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \param    aPageNr      The 256 byte page you want to start reading or writing from.
 110:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  0 if successful
 111:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 112:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_INVALID_PAGE_NR if aPageNr is invalid.
 113:../../../core/drivers/octa-flash/src/octa-flash.c ****     */
 114:../../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_open(const uint32_t aPageNr)
 115:../../../core/drivers/octa-flash/src/octa-flash.c **** {
 116:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);

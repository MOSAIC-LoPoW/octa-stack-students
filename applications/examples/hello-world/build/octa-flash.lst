 175:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 176:../../../core/drivers/octa-flash/src/octa-flash.c ****     //Starting the read.
 177:../../../core/drivers/octa-flash/src/octa-flash.c ****     int status = 0;
 178:../../../core/drivers/octa-flash/src/octa-flash.c ****     status = OCTA_FLASH_send4BCommand(SPI_READ_4B_CMD, mCurrentReadAddress);
 179:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (status!=0)
 180:../../../core/drivers/octa-flash/src/octa-flash.c ****     {

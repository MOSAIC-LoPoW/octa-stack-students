 165:../../../core/drivers/octa-flash/src/octa-flash.c ****     */
 166:../../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_read(uint8_t *apData, const uint32_t aSize)
 167:../../../core/drivers/octa-flash/src/octa-flash.c **** {
 168:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 169:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 170:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 171:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_isWriteInProgress())

 219:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 220:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 221:../../../core/drivers/octa-flash/src/octa-flash.c ****         //The number of bytes we will add to mMemBlock in this loop
 222:../../../core/drivers/octa-flash/src/octa-flash.c ****         uint32_t bytesToWrite = OCTA_FLASH_PAGE_SIZE - mMemPageIndex;
 223:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 224:../../../core/drivers/octa-flash/src/octa-flash.c ****         //Filling the remainder of the buffer
 225:../../../core/drivers/octa-flash/src/octa-flash.c ****         memcpy(&mMemPage[mMemPageIndex], apData, OCTA_FLASH_PAGE_SIZE);
 226:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 227:../../../core/drivers/octa-flash/src/octa-flash.c ****         int flushedBytes = OCTA_FLASH_flush();
 228:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 229:../../../core/drivers/octa-flash/src/octa-flash.c ****         //And writing the block of FLASH_BLOCK_SIZE bytes. This also clears mMemBlock and mMemBlock
 230:../../../core/drivers/octa-flash/src/octa-flash.c ****         if (flushedBytes < 0)
 231:../../../core/drivers/octa-flash/src/octa-flash.c ****         {
 232:../../../core/drivers/octa-flash/src/octa-flash.c ****             //Flush failed
 233:../../../core/drivers/octa-flash/src/octa-flash.c ****             printDBG("Flush failed\r\n");
 234:../../../core/drivers/octa-flash/src/octa-flash.c ****             return flushedBytes;
 235:../../../core/drivers/octa-flash/src/octa-flash.c ****         }
 236:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 237:../../../core/drivers/octa-flash/src/octa-flash.c ****         //Moving the pointer
 238:../../../core/drivers/octa-flash/src/octa-flash.c ****         apData += bytesToWrite;
 239:../../../core/drivers/octa-flash/src/octa-flash.c ****         bytesLeftToWrite -= bytesToWrite;
 240:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 241:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 242:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (mCurrentWriteAddress > LAST_FLASH_ADDRESS)
 243:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 244:../../../core/drivers/octa-flash/src/octa-flash.c ****         //Flash is full, no more buffering.
 245:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_LAST_PAGE_WRITTEN;
 246:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 247:../../../core/drivers/octa-flash/src/octa-flash.c ****     else if (bytesLeftToWrite > 0)
 248:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 249:../../../core/drivers/octa-flash/src/octa-flash.c ****         //We still have some bytes left to cache.
 250:../../../core/drivers/octa-flash/src/octa-flash.c ****         memcpy(&mMemPage[mMemPageIndex], apData, bytesLeftToWrite);
 251:../../../core/drivers/octa-flash/src/octa-flash.c ****         bytesLeftToWrite = 0;
 252:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 253:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 254:../../../core/drivers/octa-flash/src/octa-flash.c ****     return (aSize-bytesLeftToWrite);
 255:../../../core/drivers/octa-flash/src/octa-flash.c **** }
 256:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 257:../../../core/drivers/octa-flash/src/octa-flash.c **** /**
 258:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \brief    Returns the state of the write in process status bit.
ARM GAS  /tmp/ccWl9TUt.s 			page 6


 259:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  true is the flash is performing a write action.
 260:../../../core/drivers/octa-flash/src/octa-flash.c ****     */
 261:../../../core/drivers/octa-flash/src/octa-flash.c **** uint8_t OCTA_FLASH_isWriteInProgress(void)
 262:../../../core/drivers/octa-flash/src/octa-flash.c **** {
 263:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 264:../../../core/drivers/octa-flash/src/octa-flash.c ****     uint8_t status = 0;
 265:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_readReg(SPI_RDSR_CMD, &status) == 0)
 266:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 267:../../../core/drivers/octa-flash/src/octa-flash.c ****         return (uint8_t)(status & WRITE_IN_PROGRESS_MASK);
 268:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 269:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 270:../../../core/drivers/octa-flash/src/octa-flash.c ****     return 0;
 271:../../../core/drivers/octa-flash/src/octa-flash.c **** }
 272:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 273:../../../core/drivers/octa-flash/src/octa-flash.c **** /**
 274:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \brief    Erases the entire flash.
 275:../../../core/drivers/octa-flash/src/octa-flash.c ****                 This method is a write action. Poll with isWriteInProgress()
 276:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  0 if successful
 277:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 278:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_SPI_ERROR if something went wrong during SPI communication.
 279:../../../core/drivers/octa-flash/src/octa-flash.c ****     */
 280:../../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_eraseFullFlash(void)
 281:../../../core/drivers/octa-flash/src/octa-flash.c **** {
 282:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 283:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 284:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 285:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_isWriteInProgress())
 286:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 287:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_WRITE_IN_PROGRESS;        
 288:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 289:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 290:../../../core/drivers/octa-flash/src/octa-flash.c ****     //Setting write enable
 291:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_sendCommand(SPI_WREN_CMD) == E_SPI_ERROR)
 292:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 293:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_SPI_ERROR;
 294:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 295:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 296:../../../core/drivers/octa-flash/src/octa-flash.c ****     //The actual bulk erase
 297:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_sendCommand(SPI_BE_CMD) == E_SPI_ERROR)
 298:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 299:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_SPI_ERROR;
 300:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 301:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 302:../../../core/drivers/octa-flash/src/octa-flash.c ****     //And disabling write again.
 303:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_sendCommand(SPI_WRDI_CMD) == E_SPI_ERROR)
 304:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 305:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_SPI_ERROR;
 306:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 307:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 308:../../../core/drivers/octa-flash/src/octa-flash.c ****     return 0;
 309:../../../core/drivers/octa-flash/src/octa-flash.c **** }

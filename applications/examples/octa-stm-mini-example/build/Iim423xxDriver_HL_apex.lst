 156:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 			s->wom_smd_mask = IIM423XX_SMD_CONFIG_SMD_MODE_DISABLED;
 157:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 		}
 158:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	}
 159:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 
 160:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	status |= inv_iim423xx_write_reg(s, MPUREG_SMD_CONFIG, 1, &data);
 161:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 
 162:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	return status;

 116:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** int inv_iim423xx_enable_smd(struct inv_iim423xx * s)
 117:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** {
 118:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	uint8_t data;
 119:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	int status = 0;
 120:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	
 121:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	/*
 122:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	 * SMD engine is based on two occurences of WoM events within a defined timeframe.
 123:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	 * POR value for WoM mode is to compare current sample against first sample,
 124:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	 * which may happen during accel engine stabilisation and therefore could
 125:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	 * be significantly different compared to the normalised value. Comparing
 126:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	 * the two has a higher chance of leading to wrong SMD events signalling,
 127:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	 * therefore it is required to configure WoM to compare the current sample
 128:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	 * against the previous sample instead.
 129:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	 */
 130:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 
 131:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	/* Set SMD mode to SMD */
 132:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	status |= inv_iim423xx_read_reg(s, MPUREG_SMD_CONFIG, 1, &data);
 133:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	data &= (uint8_t)~BIT_SMD_CONFIG_SMD_MODE_MASK;
 134:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	data |= (uint8_t)IIM423XX_SMD_CONFIG_SMD_MODE_LONG;
 135:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	status |= inv_iim423xx_write_reg(s, MPUREG_SMD_CONFIG, 1, &data);
 136:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	/* Update mask to inform smd is enabled */
 137:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	s->wom_smd_mask = IIM423XX_SMD_CONFIG_SMD_MODE_LONG;
 138:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 
 139:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	return status;
 140:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** }
 141:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 
 142:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** int inv_iim423xx_disable_smd(struct inv_iim423xx * s)
 143:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** {
 144:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	uint8_t data;
ARM GAS  /tmp/ccXXIPwM.s 			page 4


 145:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	int status = 0;
 146:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 
 147:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	status |= inv_iim423xx_read_reg(s, MPUREG_SMD_CONFIG, 1, &data);
 148:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	data &= (uint8_t)~BIT_SMD_CONFIG_SMD_MODE_MASK;
 149:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 
 150:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	if (s->wom_smd_mask == IIM423XX_SMD_CONFIG_SMD_MODE_SHORT || 
 151:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	    s->wom_smd_mask == IIM423XX_SMD_CONFIG_SMD_MODE_LONG) {

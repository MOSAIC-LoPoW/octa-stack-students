 456:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** int inv_iim423xx_reset_dmp(struct inv_iim423xx * s)
 457:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** {
 458:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	int status = 0;
 459:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	const int ref_timeout = 5000; /*50 ms*/
 460:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	int timeout = ref_timeout;
 461:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	uint8_t data;
 462:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 
 463:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	/* Reset DMP internal memories */
 464:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	data = IIM423XX_SIGNAL_PATH_RESET_DMP_MEM_RESET_EN;
 465:../../../shields/IIM423xx/src/Iim423xxDriver_HL_apex.c **** 	status |= inv_iim423xx_write_reg(s, MPUREG_SIGNAL_PATH_RESET, 1, &data);

 188:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 189:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_SPI_Receive(flashSPI, apData, (uint16_t)aSize, HAL_MAX_DELAY);
 190:../../../core/drivers/octa-flash/src/octa-flash.c **** 

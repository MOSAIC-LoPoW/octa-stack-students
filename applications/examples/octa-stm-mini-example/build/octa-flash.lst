 569:../../../core/drivers/octa-flash/src/octa-flash.c ****     */
 570:../../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_send4BCommand(const uint8_t command, const uint32_t address)
 571:../../../core/drivers/octa-flash/src/octa-flash.c **** {
 572:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 573:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_isWriteInProgress())
 574:../../../core/drivers/octa-flash/src/octa-flash.c ****     {

 591:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 592:../../../core/drivers/octa-flash/src/octa-flash.c ****     //send the command over SPI
 593:../../../core/drivers/octa-flash/src/octa-flash.c ****     if(HAL_SPI_Transmit(flashSPI, (uint8_t *)txData, index, HAL_MAX_DELAY)!=HAL_OK)
 594:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 595:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_SPI_ERROR;
 596:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 597:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 598:../../../core/drivers/octa-flash/src/octa-flash.c ****     return OCTA_FLASH_OK;

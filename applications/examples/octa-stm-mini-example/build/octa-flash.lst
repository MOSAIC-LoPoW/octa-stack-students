 169:../../../core/drivers/octa-flash/src/octa-flash.c ****     */
 170:../../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_read(uint8_t *apData, const uint32_t aSize)
 171:../../../core/drivers/octa-flash/src/octa-flash.c **** {
 172:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 173:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 174:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 175:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_isWriteInProgress())

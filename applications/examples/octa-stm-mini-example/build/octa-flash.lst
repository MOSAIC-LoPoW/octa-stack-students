 578:../../../core/drivers/octa-flash/src/octa-flash.c ****     uint8_t index = 0;
 579:../../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = command;
 580:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 581:../../../core/drivers/octa-flash/src/octa-flash.c ****     //Writing 4 byte address.
 582:../../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = (uint8_t)((address >> 24) & 0x000000FF);
 583:../../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = (uint8_t)((address >> 16) & 0x000000FF);
 584:../../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = (uint8_t)((address >> 8) & 0x000000FF);
 585:../../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = (uint8_t)(address & 0x000000FF);
 586:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 587:../../../core/drivers/octa-flash/src/octa-flash.c ****     //We have to enable SPI here, because isWriteInProgress disables it.

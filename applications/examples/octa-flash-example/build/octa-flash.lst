 225:../../core/drivers/octa-flash/src/octa-flash.c ****             return flushedBytes;
 226:../../core/drivers/octa-flash/src/octa-flash.c ****         }
 227:../../core/drivers/octa-flash/src/octa-flash.c **** 
 228:../../core/drivers/octa-flash/src/octa-flash.c ****         //Moving the pointer
 229:../../core/drivers/octa-flash/src/octa-flash.c ****         apData += bytesToWrite;
 230:../../core/drivers/octa-flash/src/octa-flash.c ****         bytesLeftToWrite -= bytesToWrite;
 231:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 232:../../core/drivers/octa-flash/src/octa-flash.c **** 
 233:../../core/drivers/octa-flash/src/octa-flash.c ****     if (mCurrentWriteAddress > LAST_FLASH_ADDRESS)
 234:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 235:../../core/drivers/octa-flash/src/octa-flash.c ****         //Flash is full, no more buffering.
 236:../../core/drivers/octa-flash/src/octa-flash.c ****         return E_LAST_PAGE_WRITTEN;
 237:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 238:../../core/drivers/octa-flash/src/octa-flash.c ****     else if (bytesLeftToWrite > 0)
 239:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 240:../../core/drivers/octa-flash/src/octa-flash.c ****         //We still have some bytes left to cache.
 241:../../core/drivers/octa-flash/src/octa-flash.c ****         memcpy(&mMemPage[mMemPageIndex], apData, bytesLeftToWrite);
 242:../../core/drivers/octa-flash/src/octa-flash.c ****         bytesLeftToWrite = 0;
 243:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 244:../../core/drivers/octa-flash/src/octa-flash.c **** 
 245:../../core/drivers/octa-flash/src/octa-flash.c ****     return (aSize-bytesLeftToWrite);
 246:../../core/drivers/octa-flash/src/octa-flash.c **** }

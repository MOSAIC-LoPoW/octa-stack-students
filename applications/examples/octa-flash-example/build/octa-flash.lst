 220:../../core/drivers/octa-flash/src/octa-flash.c ****         //And writing the block of FLASH_BLOCK_SIZE bytes. This also clears mMemBlock and mMemBlock
 221:../../core/drivers/octa-flash/src/octa-flash.c ****         if (flushedBytes < 0)

 213:../../core/drivers/octa-flash/src/octa-flash.c ****         uint32_t bytesToWrite = OCTA_FLASH_PAGE_SIZE - mMemPageIndex;
 214:../../core/drivers/octa-flash/src/octa-flash.c **** 
 215:../../core/drivers/octa-flash/src/octa-flash.c ****         //Filling the remainder of the buffer
 216:../../core/drivers/octa-flash/src/octa-flash.c ****         memcpy(&mMemPage[mMemPageIndex], apData, OCTA_FLASH_PAGE_SIZE);
 217:../../core/drivers/octa-flash/src/octa-flash.c **** 

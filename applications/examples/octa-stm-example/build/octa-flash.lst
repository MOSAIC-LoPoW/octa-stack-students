 261:../../../core/drivers/octa-flash/src/octa-flash.c **** /**
 262:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \brief    Returns the state of the write in process status bit.
 263:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  true is the flash is performing a write action.
 264:../../../core/drivers/octa-flash/src/octa-flash.c ****     */
 265:../../../core/drivers/octa-flash/src/octa-flash.c **** uint8_t OCTA_FLASH_isWriteInProgress(void)
 266:../../../core/drivers/octa-flash/src/octa-flash.c **** {
 267:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 268:../../../core/drivers/octa-flash/src/octa-flash.c ****     uint8_t status = 0;
 269:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_readReg(SPI_RDSR_CMD, &status) == 0)
 270:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 271:../../../core/drivers/octa-flash/src/octa-flash.c ****         return (uint8_t)(status & WRITE_IN_PROGRESS_MASK);
 272:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 273:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 274:../../../core/drivers/octa-flash/src/octa-flash.c ****     return 0;
 275:../../../core/drivers/octa-flash/src/octa-flash.c **** }
 276:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 277:../../../core/drivers/octa-flash/src/octa-flash.c **** /**
 278:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \brief    Erases the entire flash.
 279:../../../core/drivers/octa-flash/src/octa-flash.c ****                 This method is a write action. Poll with isWriteInProgress()
 280:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  0 if successful
 281:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 282:../../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_SPI_ERROR if something went wrong during SPI communication.
 283:../../../core/drivers/octa-flash/src/octa-flash.c ****     */
 284:../../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_eraseFullFlash(void)
 285:../../../core/drivers/octa-flash/src/octa-flash.c **** {
 286:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 287:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 288:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 289:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_isWriteInProgress())
 290:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 291:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_WRITE_IN_PROGRESS;        
 292:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 293:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 294:../../../core/drivers/octa-flash/src/octa-flash.c ****     //Setting write enable
 295:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_sendCommand(SPI_WREN_CMD) == E_SPI_ERROR)
 296:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 297:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_SPI_ERROR;
 298:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 299:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 300:../../../core/drivers/octa-flash/src/octa-flash.c ****     //The actual bulk erase
 301:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_sendCommand(SPI_BE_CMD) == E_SPI_ERROR)
 302:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 303:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_SPI_ERROR;
 304:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 305:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 306:../../../core/drivers/octa-flash/src/octa-flash.c ****     //And disabling write again.
 307:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_sendCommand(SPI_WRDI_CMD) == E_SPI_ERROR)
 308:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 309:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_SPI_ERROR;
 310:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 311:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 312:../../../core/drivers/octa-flash/src/octa-flash.c ****     return 0;
 313:../../../core/drivers/octa-flash/src/octa-flash.c **** }

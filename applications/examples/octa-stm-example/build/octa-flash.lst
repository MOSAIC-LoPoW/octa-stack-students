 187:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 188:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 189:../../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_SPI_Receive(flashSPI, apData, (uint16_t)aSize, HAL_MAX_DELAY);
 190:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 191:../../../core/drivers/octa-flash/src/octa-flash.c ****     OCTA_FLASH_Disable();
 192:../../../core/drivers/octa-flash/src/octa-flash.c ****     __HAL_SPI_DISABLE(flashSPI);
 193:../../../core/drivers/octa-flash/src/octa-flash.c **** 

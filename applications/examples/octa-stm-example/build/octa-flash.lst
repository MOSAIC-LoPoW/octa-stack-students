 123:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 124:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_WRITE_IN_PROGRESS;
 125:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 126:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 127:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (aPageNr > MAX_PAGE_NUMBER)
 128:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 129:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_INVALID_PAGE_NR;
 130:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 131:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 132:../../../core/drivers/octa-flash/src/octa-flash.c ****     uint32_t newAddress = FIRST_FLASH_ADDRESS + aPageNr * (OCTA_FLASH_PAGE_SIZE);

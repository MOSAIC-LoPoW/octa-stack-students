 220:../../../core/drivers/octa-flash/src/octa-flash.c ****     uint32_t bytesLeftToWrite = aSize;
 221:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 222:../../../core/drivers/octa-flash/src/octa-flash.c ****     while (mMemPageIndex + bytesLeftToWrite >= OCTA_FLASH_PAGE_SIZE)
 223:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 224:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 225:../../../core/drivers/octa-flash/src/octa-flash.c ****         //The number of bytes we will add to mMemBlock in this loop
 226:../../../core/drivers/octa-flash/src/octa-flash.c ****         uint32_t bytesToWrite = OCTA_FLASH_PAGE_SIZE - mMemPageIndex;
 227:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 228:../../../core/drivers/octa-flash/src/octa-flash.c ****         //Filling the remainder of the buffer
 229:../../../core/drivers/octa-flash/src/octa-flash.c ****         memcpy(&mMemPage[mMemPageIndex], apData, OCTA_FLASH_PAGE_SIZE);
 230:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 231:../../../core/drivers/octa-flash/src/octa-flash.c ****         int flushedBytes = OCTA_FLASH_flush();
 232:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 233:../../../core/drivers/octa-flash/src/octa-flash.c ****         //And writing the block of FLASH_BLOCK_SIZE bytes. This also clears mMemBlock and mMemBlock
 234:../../../core/drivers/octa-flash/src/octa-flash.c ****         if (flushedBytes < 0)
 235:../../../core/drivers/octa-flash/src/octa-flash.c ****         {
 236:../../../core/drivers/octa-flash/src/octa-flash.c ****             //Flush failed
 237:../../../core/drivers/octa-flash/src/octa-flash.c ****             printDBG("Flush failed\r\n");
 238:../../../core/drivers/octa-flash/src/octa-flash.c ****             return flushedBytes;
 239:../../../core/drivers/octa-flash/src/octa-flash.c ****         }
 240:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 241:../../../core/drivers/octa-flash/src/octa-flash.c ****         //Moving the pointer
 242:../../../core/drivers/octa-flash/src/octa-flash.c ****         apData += bytesToWrite;
 243:../../../core/drivers/octa-flash/src/octa-flash.c ****         bytesLeftToWrite -= bytesToWrite;
 244:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 245:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 246:../../../core/drivers/octa-flash/src/octa-flash.c ****     if (mCurrentWriteAddress > LAST_FLASH_ADDRESS)
 247:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 248:../../../core/drivers/octa-flash/src/octa-flash.c ****         //Flash is full, no more buffering.
 249:../../../core/drivers/octa-flash/src/octa-flash.c ****         return E_LAST_PAGE_WRITTEN;
 250:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 251:../../../core/drivers/octa-flash/src/octa-flash.c ****     else if (bytesLeftToWrite > 0)
 252:../../../core/drivers/octa-flash/src/octa-flash.c ****     {
 253:../../../core/drivers/octa-flash/src/octa-flash.c ****         //We still have some bytes left to cache.
 254:../../../core/drivers/octa-flash/src/octa-flash.c ****         memcpy(&mMemPage[mMemPageIndex], apData, bytesLeftToWrite);
 255:../../../core/drivers/octa-flash/src/octa-flash.c ****         bytesLeftToWrite = 0;
 256:../../../core/drivers/octa-flash/src/octa-flash.c ****     }
 257:../../../core/drivers/octa-flash/src/octa-flash.c **** 
 258:../../../core/drivers/octa-flash/src/octa-flash.c ****     return (aSize-bytesLeftToWrite);

 371:../../applications/examples/lora-gps-example/src/lora-gps-example.c ****          printINF("Stopping lorawan timer\r\n");
 372:../../applications/examples/lora-gps-example/src/lora-gps-example.c ****          osTimerStop(loraWANTimId);
 373:../../applications/examples/lora-gps-example/src/lora-gps-example.c **** 
 374:../../applications/examples/lora-gps-example/src/lora-gps-example.c ****           uint32_t index;

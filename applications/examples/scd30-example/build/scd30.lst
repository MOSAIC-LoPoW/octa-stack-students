  96:../../shields/SCD30/src/scd30.c ****     if (ambient_pressure_mbar &&
  97:../../shields/SCD30/src/scd30.c ****         (ambient_pressure_mbar < 700 || ambient_pressure_mbar > 1400)) {
  98:../../shields/SCD30/src/scd30.c ****         /* out of allowable range */

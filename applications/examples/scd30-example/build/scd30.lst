 315:../../shields/SCD30/src/scd30.c **** int16_t sensirion_i2c_read_words_as_bytes(uint8_t address, uint8_t* data,
 316:../../shields/SCD30/src/scd30.c ****                                           uint16_t num_words) {
 317:../../shields/SCD30/src/scd30.c ****     int16_t ret;
 318:../../shields/SCD30/src/scd30.c ****     uint16_t i, j;
 319:../../shields/SCD30/src/scd30.c ****     uint16_t size = num_words * (SENSIRION_WORD_SIZE + CRC8_LEN);
 320:../../shields/SCD30/src/scd30.c ****     uint16_t word_buf[SENSIRION_MAX_BUFFER_WORDS];
 321:../../shields/SCD30/src/scd30.c ****     uint8_t* const buf8 = (uint8_t*)word_buf;
 322:../../shields/SCD30/src/scd30.c **** 
 323:../../shields/SCD30/src/scd30.c ****     ret = sensirion_i2c_read(address, buf8, size);
 324:../../shields/SCD30/src/scd30.c ****     if (ret != NO_ERROR)
 325:../../shields/SCD30/src/scd30.c ****         return ret;
 326:../../shields/SCD30/src/scd30.c **** 
 327:../../shields/SCD30/src/scd30.c ****     /* check the CRC for each word */
 328:../../shields/SCD30/src/scd30.c ****     for (i = 0, j = 0; i < size; i += SENSIRION_WORD_SIZE + CRC8_LEN) {
 329:../../shields/SCD30/src/scd30.c **** 
 330:../../shields/SCD30/src/scd30.c ****         ret = sensirion_common_check_crc(&buf8[i], SENSIRION_WORD_SIZE,
 331:../../shields/SCD30/src/scd30.c ****                                          buf8[i + SENSIRION_WORD_SIZE]);
 332:../../shields/SCD30/src/scd30.c ****         if (ret != NO_ERROR)
 333:../../shields/SCD30/src/scd30.c ****             return ret;
 334:../../shields/SCD30/src/scd30.c **** 
 335:../../shields/SCD30/src/scd30.c ****         data[j++] = buf8[i];
 336:../../shields/SCD30/src/scd30.c ****         data[j++] = buf8[i + 1];
 337:../../shields/SCD30/src/scd30.c ****     }
 338:../../shields/SCD30/src/scd30.c **** 
 339:../../shields/SCD30/src/scd30.c ****     return NO_ERROR;
 340:../../shields/SCD30/src/scd30.c **** }

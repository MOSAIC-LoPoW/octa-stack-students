  69:../../core/drivers/S25FL256/src/S25FL256.c ****     {
  70:../../core/drivers/S25FL256/src/S25FL256.c ****         return E_WRITE_IN_PROGRESS;
  71:../../core/drivers/S25FL256/src/S25FL256.c ****     }
  72:../../core/drivers/S25FL256/src/S25FL256.c **** 
  73:../../core/drivers/S25FL256/src/S25FL256.c ****     if (aPageNr > MAX_PAGE_NUMBER)
  74:../../core/drivers/S25FL256/src/S25FL256.c ****     {
  75:../../core/drivers/S25FL256/src/S25FL256.c ****         return E_INVALID_PAGE_NR;
  76:../../core/drivers/S25FL256/src/S25FL256.c ****     }
  77:../../core/drivers/S25FL256/src/S25FL256.c **** 
  78:../../core/drivers/S25FL256/src/S25FL256.c ****     uint32_t newAddress = FIRST_FLASH_ADDRESS + aPageNr * (OCTA_FLASH_PAGE_SIZE);
  79:../../core/drivers/S25FL256/src/S25FL256.c ****     mCurrentReadAddress = newAddress;
  80:../../core/drivers/S25FL256/src/S25FL256.c ****     mCurrentWriteAddress = newAddress;
  81:../../core/drivers/S25FL256/src/S25FL256.c **** 
  82:../../core/drivers/S25FL256/src/S25FL256.c ****     return 0;
  83:../../core/drivers/S25FL256/src/S25FL256.c **** }

 508:../../core/drivers/S25FL256/src/S25FL256.c **** /**
 509:../../core/drivers/S25FL256/src/S25FL256.c ****     * \brief    Sends a 4 byte address command
 510:../../core/drivers/S25FL256/src/S25FL256.c ****     * \param    command   The command to be sent.
 511:../../core/drivers/S25FL256/src/S25FL256.c ****     * \param    address  The 4 byte address
 512:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  0 if successful
 513:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 514:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_SPI_ERROR if something went wrong during SPI communication.
 515:../../core/drivers/S25FL256/src/S25FL256.c ****     */
 516:../../core/drivers/S25FL256/src/S25FL256.c **** int S25FL256_send4BCommand(const uint8_t command, const uint32_t address)
 517:../../core/drivers/S25FL256/src/S25FL256.c **** {
 518:../../core/drivers/S25FL256/src/S25FL256.c **** 
 519:../../core/drivers/S25FL256/src/S25FL256.c ****     if (S25FL256_isWriteInProgress())
 520:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 521:../../core/drivers/S25FL256/src/S25FL256.c ****         return E_WRITE_IN_PROGRESS;
 522:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 523:../../core/drivers/S25FL256/src/S25FL256.c **** 
 524:../../core/drivers/S25FL256/src/S25FL256.c ****     uint8_t index = 0;
 525:../../core/drivers/S25FL256/src/S25FL256.c ****     txData[index++] = command;
 526:../../core/drivers/S25FL256/src/S25FL256.c **** 
 527:../../core/drivers/S25FL256/src/S25FL256.c ****     //Writing 4 byte address.
 528:../../core/drivers/S25FL256/src/S25FL256.c ****     txData[index++] = (uint8_t)((address >> 24) & 0x000000FF);
 529:../../core/drivers/S25FL256/src/S25FL256.c ****     txData[index++] = (uint8_t)((address >> 16) & 0x000000FF);
 530:../../core/drivers/S25FL256/src/S25FL256.c ****     txData[index++] = (uint8_t)((address >> 8) & 0x000000FF);
 531:../../core/drivers/S25FL256/src/S25FL256.c ****     txData[index++] = (uint8_t)(address & 0x000000FF);
 532:../../core/drivers/S25FL256/src/S25FL256.c **** 
 533:../../core/drivers/S25FL256/src/S25FL256.c ****     //We have to enable SPI here, because isWriteInProgress disables it.
 534:../../core/drivers/S25FL256/src/S25FL256.c ****     //We don't disable it here, because CS has to stay high after this command.
 535:../../core/drivers/S25FL256/src/S25FL256.c ****     S25FL256_Enable();
 536:../../core/drivers/S25FL256/src/S25FL256.c ****     __HAL_SPI_ENABLE(flashSPI);
 537:../../core/drivers/S25FL256/src/S25FL256.c **** 
 538:../../core/drivers/S25FL256/src/S25FL256.c ****     //send the command over SPI
 539:../../core/drivers/S25FL256/src/S25FL256.c ****     if(HAL_SPI_Transmit(flashSPI, (uint8_t *)txData, index, HAL_MAX_DELAY)!=HAL_OK)
 540:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 541:../../core/drivers/S25FL256/src/S25FL256.c ****         return E_SPI_ERROR;
 542:../../core/drivers/S25FL256/src/S25FL256.c ****     }

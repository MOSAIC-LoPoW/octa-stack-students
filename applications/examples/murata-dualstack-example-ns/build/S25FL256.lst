  57:../../core/drivers/S25FL256/src/S25FL256.c **** /**
  58:../../core/drivers/S25FL256/src/S25FL256.c ****     * \brief    Sets the read and write address to the start of this page. The max value is defined
  59:../../core/drivers/S25FL256/src/S25FL256.c ****     * \param    aPageNr      The 256 byte page you want to start reading or writing from.
  60:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  0 if successful
  61:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
  62:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_INVALID_PAGE_NR if aPageNr is invalid.
  63:../../core/drivers/S25FL256/src/S25FL256.c ****     */
  64:../../core/drivers/S25FL256/src/S25FL256.c **** int S25FL256_open(const uint32_t aPageNr)
  65:../../core/drivers/S25FL256/src/S25FL256.c **** {

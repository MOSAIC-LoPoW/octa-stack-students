 108:../../core/drivers/S25FL256/src/S25FL256.c **** /**
 109:../../core/drivers/S25FL256/src/S25FL256.c ****     * \brief    Reads the given number of bytes from flash.
 110:../../core/drivers/S25FL256/src/S25FL256.c ****     * \param    apData     Pointer to the uint8_t array to fill.
 111:../../core/drivers/S25FL256/src/S25FL256.c ****     * \param    aSize      The number of bytes to be read.
 112:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  the number of bytes read if successful
 113:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 114:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_SPI_ERROR if something went wrong during SPI communication.
 115:../../core/drivers/S25FL256/src/S25FL256.c ****     */
 116:../../core/drivers/S25FL256/src/S25FL256.c **** int S25FL256_read(uint8_t *apData, const uint32_t aSize)
 117:../../core/drivers/S25FL256/src/S25FL256.c **** {
 118:../../core/drivers/S25FL256/src/S25FL256.c **** 
 119:../../core/drivers/S25FL256/src/S25FL256.c ****     HAL_Delay(SPI_WAIT);
 120:../../core/drivers/S25FL256/src/S25FL256.c **** 
 121:../../core/drivers/S25FL256/src/S25FL256.c ****     if (S25FL256_isWriteInProgress())
 122:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 123:../../core/drivers/S25FL256/src/S25FL256.c ****         return E_WRITE_IN_PROGRESS;
 124:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 125:../../core/drivers/S25FL256/src/S25FL256.c **** 
 126:../../core/drivers/S25FL256/src/S25FL256.c ****     //Starting the read.
 127:../../core/drivers/S25FL256/src/S25FL256.c ****     int status = 0;
 128:../../core/drivers/S25FL256/src/S25FL256.c ****     status = S25FL256_send4BCommand(SPI_READ_4B_CMD, mCurrentReadAddress);
 129:../../core/drivers/S25FL256/src/S25FL256.c ****     if (status!=0)
 130:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 131:../../core/drivers/S25FL256/src/S25FL256.c ****         printDBG("\r\n FLASH read error: %d\r\n", status);
 132:../../core/drivers/S25FL256/src/S25FL256.c ****         return status;
 133:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 134:../../core/drivers/S25FL256/src/S25FL256.c **** 
 135:../../core/drivers/S25FL256/src/S25FL256.c ****     HAL_SPI_Receive(flashSPI, apData, (uint16_t)aSize, HAL_MAX_DELAY);
 136:../../core/drivers/S25FL256/src/S25FL256.c **** 
 137:../../core/drivers/S25FL256/src/S25FL256.c ****     S25FL256_Disable();
 138:../../core/drivers/S25FL256/src/S25FL256.c ****     __HAL_SPI_DISABLE(flashSPI);
 139:../../core/drivers/S25FL256/src/S25FL256.c **** 
 140:../../core/drivers/S25FL256/src/S25FL256.c ****     return aSize;
 141:../../core/drivers/S25FL256/src/S25FL256.c **** }
 142:../../core/drivers/S25FL256/src/S25FL256.c **** 
 143:../../core/drivers/S25FL256/src/S25FL256.c **** /**
 144:../../core/drivers/S25FL256/src/S25FL256.c ****     * \brief    Buffers the given array. Once 256 bytes are cached, the data is flushed to flash.
ARM GAS  /tmp/cc2dKMU7.s 			page 4


 145:../../core/drivers/S25FL256/src/S25FL256.c ****     * \param    apData     Pointer to the uint8_t array with data to write.
 146:../../core/drivers/S25FL256/src/S25FL256.c ****     * \param    aSize      The number of bytes to be written.
 147:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  The number of written bytes.
 148:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 149:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_SPI_ERROR if something went wrong during SPI communication.
 150:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_LAST_PAGE_WRITTEN if the last block was written and no more data can be buffered.
 151:../../core/drivers/S25FL256/src/S25FL256.c ****     */
 152:../../core/drivers/S25FL256/src/S25FL256.c **** int S25FL256_write(const uint8_t *apData, const uint32_t aSize)
 153:../../core/drivers/S25FL256/src/S25FL256.c **** {
 154:../../core/drivers/S25FL256/src/S25FL256.c ****     HAL_Delay(SPI_WAIT);
 155:../../core/drivers/S25FL256/src/S25FL256.c **** 
 156:../../core/drivers/S25FL256/src/S25FL256.c ****     if (S25FL256_isWriteInProgress())
 157:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 158:../../core/drivers/S25FL256/src/S25FL256.c ****         return E_WRITE_IN_PROGRESS;
 159:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 160:../../core/drivers/S25FL256/src/S25FL256.c **** 
 161:../../core/drivers/S25FL256/src/S25FL256.c ****     if (mCurrentWriteAddress > LAST_FLASH_ADDRESS)
 162:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 163:../../core/drivers/S25FL256/src/S25FL256.c ****         return E_LAST_PAGE_WRITTEN;
 164:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 165:../../core/drivers/S25FL256/src/S25FL256.c **** 
 166:../../core/drivers/S25FL256/src/S25FL256.c ****     uint32_t bytesLeftToWrite = aSize;
 167:../../core/drivers/S25FL256/src/S25FL256.c **** 
 168:../../core/drivers/S25FL256/src/S25FL256.c ****     while (mMemPageIndex + bytesLeftToWrite >= OCTA_FLASH_PAGE_SIZE)
 169:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 170:../../core/drivers/S25FL256/src/S25FL256.c **** 
 171:../../core/drivers/S25FL256/src/S25FL256.c ****         //The number of bytes we will add to mMemBlock in this loop
 172:../../core/drivers/S25FL256/src/S25FL256.c ****         uint32_t bytesToWrite = OCTA_FLASH_PAGE_SIZE - mMemPageIndex;
 173:../../core/drivers/S25FL256/src/S25FL256.c **** 
 174:../../core/drivers/S25FL256/src/S25FL256.c ****         //Filling the remainder of the buffer
 175:../../core/drivers/S25FL256/src/S25FL256.c ****         memcpy(&mMemPage[mMemPageIndex], apData, OCTA_FLASH_PAGE_SIZE);
 176:../../core/drivers/S25FL256/src/S25FL256.c **** 
 177:../../core/drivers/S25FL256/src/S25FL256.c ****         int flushedBytes = S25FL256_flush();
 178:../../core/drivers/S25FL256/src/S25FL256.c **** 
 179:../../core/drivers/S25FL256/src/S25FL256.c ****         //And writing the block of FLASH_BLOCK_SIZE bytes. This also clears mMemBlock and mMemBlock
 180:../../core/drivers/S25FL256/src/S25FL256.c ****         if (flushedBytes < 0)
 181:../../core/drivers/S25FL256/src/S25FL256.c ****         {
 182:../../core/drivers/S25FL256/src/S25FL256.c ****             //Flush failed
 183:../../core/drivers/S25FL256/src/S25FL256.c ****             printDBG("Flush failed\r\n");
 184:../../core/drivers/S25FL256/src/S25FL256.c ****             return flushedBytes;
 185:../../core/drivers/S25FL256/src/S25FL256.c ****         }
 186:../../core/drivers/S25FL256/src/S25FL256.c **** 
 187:../../core/drivers/S25FL256/src/S25FL256.c ****         //Moving the pointer
 188:../../core/drivers/S25FL256/src/S25FL256.c ****         apData += bytesToWrite;
 189:../../core/drivers/S25FL256/src/S25FL256.c ****         bytesLeftToWrite -= bytesToWrite;
 190:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 191:../../core/drivers/S25FL256/src/S25FL256.c **** 
 192:../../core/drivers/S25FL256/src/S25FL256.c ****     if (mCurrentWriteAddress > LAST_FLASH_ADDRESS)
 193:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 194:../../core/drivers/S25FL256/src/S25FL256.c ****         //Flash is full, no more buffering.
 195:../../core/drivers/S25FL256/src/S25FL256.c ****         return E_LAST_PAGE_WRITTEN;
 196:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 197:../../core/drivers/S25FL256/src/S25FL256.c ****     else if (bytesLeftToWrite > 0)
 198:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 199:../../core/drivers/S25FL256/src/S25FL256.c ****         //We still have some bytes left to cache.
 200:../../core/drivers/S25FL256/src/S25FL256.c ****         memcpy(&mMemPage[mMemPageIndex], apData, bytesLeftToWrite);
 201:../../core/drivers/S25FL256/src/S25FL256.c ****         bytesLeftToWrite = 0;
ARM GAS  /tmp/cc2dKMU7.s 			page 5


 202:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 203:../../core/drivers/S25FL256/src/S25FL256.c **** 
 204:../../core/drivers/S25FL256/src/S25FL256.c ****     return (aSize-bytesLeftToWrite);
 205:../../core/drivers/S25FL256/src/S25FL256.c **** }
 206:../../core/drivers/S25FL256/src/S25FL256.c **** 
 207:../../core/drivers/S25FL256/src/S25FL256.c **** /**
 208:../../core/drivers/S25FL256/src/S25FL256.c ****     * \brief    Returns the state of the write in process status bit.
 209:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  true is the flash is performing a write action.
 210:../../core/drivers/S25FL256/src/S25FL256.c ****     */
 211:../../core/drivers/S25FL256/src/S25FL256.c **** uint8_t S25FL256_isWriteInProgress(void)
 212:../../core/drivers/S25FL256/src/S25FL256.c **** {
 213:../../core/drivers/S25FL256/src/S25FL256.c ****     HAL_Delay(SPI_WAIT);
 214:../../core/drivers/S25FL256/src/S25FL256.c ****     uint8_t status = 0;
 215:../../core/drivers/S25FL256/src/S25FL256.c ****     if (S25FL256_readReg(SPI_RDSR_CMD, &status) == 0)
 216:../../core/drivers/S25FL256/src/S25FL256.c ****     {
 217:../../core/drivers/S25FL256/src/S25FL256.c ****         return (uint8_t)(status & WRITE_IN_PROGRESS_MASK);
 218:../../core/drivers/S25FL256/src/S25FL256.c ****     }
 219:../../core/drivers/S25FL256/src/S25FL256.c **** 
 220:../../core/drivers/S25FL256/src/S25FL256.c ****     return 0;
 221:../../core/drivers/S25FL256/src/S25FL256.c **** }
 222:../../core/drivers/S25FL256/src/S25FL256.c **** 
 223:../../core/drivers/S25FL256/src/S25FL256.c **** /**
 224:../../core/drivers/S25FL256/src/S25FL256.c ****     * \brief    Erases the entire flash.
 225:../../core/drivers/S25FL256/src/S25FL256.c ****                 This method is a write action. Poll with isWriteInProgress()
 226:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  0 if successful
 227:../../core/drivers/S25FL256/src/S25FL256.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.

 106:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 						return INV_ERROR_BAD_ARG; // Cached registers must not be written from AUX interface
 107:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 					else
 108:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 						*cache_addr = buf[i]; // Update register cache if the current bank is 0
 109:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 				}
 110:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 			}
 111:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		}
 112:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	}
 113:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	
 114:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// Physical access to write registers
 115:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	if(t->serif.write_reg(&(t->serif), reg, buf, len) != 0)
 116:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		return INV_ERROR_TRANSPORT;
 117:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 
 118:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	return 0;
 119:../../../shields/IIM423xx/src/Iim423xxTransport.c **** }

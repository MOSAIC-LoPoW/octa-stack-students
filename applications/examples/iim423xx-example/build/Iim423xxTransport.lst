  53:../../../shields/IIM423xx/src/Iim423xxTransport.c **** int inv_iim423xx_read_reg(struct inv_iim423xx * s, uint8_t reg, uint32_t len, uint8_t * buf)
  54:../../../shields/IIM423xx/src/Iim423xxTransport.c **** {
  55:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// First field of struct inv_iim423xx is assumed to be a struct inv_iim423xx_transport object.
  56:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// So let's cast s to struct inv_iim423xx_transport and ignore the rest of struct inv_iim423xx.
  57:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	struct inv_iim423xx_transport *t = (struct inv_iim423xx_transport *)s;
  58:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	uint32_t i=0;
  59:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	
  60:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// Registers in cache are only in bank 0
  61:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// Check if bank0 is used because of duplicate register addresses between banks
  62:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// For AUX interface, register cache must not be used
  63:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	if((t->register_cache.bank_sel_reg == 0) && (is_aux_interface(t) == 0)) {
  64:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		for(i=0; i<len ; i++) {
  65:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 			uint8_t * cache_addr  = get_register_cache_addr(s, reg+i);
  66:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 			if(cache_addr)
  67:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 				buf[i] = *cache_addr;
  68:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 			else
  69:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 				break; // If one register isn't in cache, exit the loop and proceed a physical access
  70:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		}
  71:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		
  72:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		if(i==len) // If the end of loop is reached, then all registers have been read in cache so return
  73:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 			return 0;
  74:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	}
  75:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	
  76:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// Physical access to read registers
  77:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	if((len-i) > t->serif.max_read)
  78:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		return INV_ERROR_SIZE;
  79:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	if(t->serif.read_reg(&(t->serif), reg+i, &buf[i], len-i) != 0)
  80:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		return INV_ERROR_TRANSPORT;
  81:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	
  82:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	return 0;
  83:../../../shields/IIM423xx/src/Iim423xxTransport.c **** }
  84:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 
  85:../../../shields/IIM423xx/src/Iim423xxTransport.c **** int inv_iim423xx_write_reg(struct inv_iim423xx * s, uint8_t reg, uint32_t len, const uint8_t * buf)
  86:../../../shields/IIM423xx/src/Iim423xxTransport.c **** {
  87:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// First field of struct inv_iim423xx is assumed to be a struct inv_iim423xx_transport object.
ARM GAS  /tmp/ccu8lkIv.s 			page 3


  88:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	// So let's cast s to struct inv_iim423xx_transport and ignore the rest of struct inv_iim423xx.
  89:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	struct inv_iim423xx_transport *t = (struct inv_iim423xx_transport *)s;

  94:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	
  95:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	
  96:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 	for(i=0; i<len; i++) {
  97:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		// Update bank_sel_reg in the cache
  98:../../../shields/IIM423xx/src/Iim423xxTransport.c **** 		if((reg+i) == MPUREG_REG_BANK_SEL){

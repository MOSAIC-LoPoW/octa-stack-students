  88:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	/* Reset the internal registers and restores the default settings.
  89:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	 * The bit automatically clears to 0 once the reset is done.
  90:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	 * Since soft-reset will trigger OTP reload, SPI mode (bit4) does not need saving
  91:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	 */
  92:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	data = IIM423XX_DEVICE_CONFIG_RESET_EN;
  93:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_write_reg(s, MPUREG_DEVICE_CONFIG, 1, &data);
  94:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	if(status)
  95:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 		return status;
  96:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
  97:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	/* Wait 1000us for soft reset to be effective before trying to perform any further read */
  98:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	//inv_iim423xx_sleep_us(1000);
  99:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	HAL_Delay(1000);
 100:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 101:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	IWDG_feed(NULL);
 102:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_set_reg_bank(s, 1);
 103:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_write_reg(s, MPUREG_INTF_CONFIG4_B1, 1, &intf_cfg4_reg);
 104:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_set_reg_bank(s, 0);
 105:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 106:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	HAL_Delay(1000);
 107:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 108:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	IWDG_feed(NULL);
 109:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 110:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	/* Check the Int Reset Done bit */
 111:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_read_reg(s, MPUREG_INT_STATUS, 1, &data);
 112:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	if (0 == (data & BIT_INT_STATUS_RESET_DONE)) {
 113:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 		printERR("INT RESET DONE BIT wrong: is %d, should be %d\r\n", data, BIT_INT_STATUS_RESET_DONE);
 114:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 		return INV_ERROR_UNEXPECTED;
 115:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	}
 116:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 117:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	IWDG_feed(NULL);
 118:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 119:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	/* Init transport layer */
 120:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	inv_iim423xx_init_transport(s);
 121:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	
 122:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_set_reg_bank(s, 1);
 123:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_write_reg(s, MPUREG_INTF_CONFIG6_B1, 1, &intf_cfg6_reg);
 124:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	/* Configure FSYNC on INT2=pin 9 */
 125:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_read_reg(s, MPUREG_INTF_CONFIG5_B1, 1, &data);
 126:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	data &= (uint8_t)~BIT_INTF_CONFIG5_GPIO_PAD_SEL_MASK;
 127:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	data |= (1 << BIT_INTF_CONFIG5_GPIO_PAD_SEL_POS);
 128:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_write_reg(s, MPUREG_INTF_CONFIG5_B1, 1, &data);
 129:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_set_reg_bank(s, 0);
 130:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 131:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	/* Read and set endianess for further processing */
 132:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_read_reg(s, MPUREG_INTF_CONFIG0, 1, &data);
 133:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	s->endianess_data = data & BIT_DATA_ENDIAN_MASK;
 134:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 135:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	if(s->transport.serif.serif_type == IIM423XX_UI_I3C){
 136:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 		status |= s->transport.serif.configure((struct inv_iim423xx_serif *)s);
 137:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	}
 138:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 
 139:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	return status;
 140:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** }

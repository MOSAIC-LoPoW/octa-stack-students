  82:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	/* save registers necessary to perform soft reset while still keeping communication link alive */
  83:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_read_reg(s, MPUREG_INTF_CONFIG4_B1, 1, &intf_cfg4_reg); // AUX SPI and AP S
  84:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_read_reg(s, MPUREG_INTF_CONFIG6_B1, 1, &intf_cfg6_reg);
  85:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	/* Set memory bank 0 */
  86:../../../shields/IIM423xx/src/Iim423xxDriver_HL.c **** 	status |= inv_iim423xx_set_reg_bank(s, 0);

 153:../../core/drivers/octa-flash/src/octa-flash.c **** /**
 154:../../core/drivers/octa-flash/src/octa-flash.c ****     * \brief    Buffers the given array. Once 256 bytes are cached, the data is flushed to flash.
 155:../../core/drivers/octa-flash/src/octa-flash.c ****     * \param    apData     Pointer to the uint8_t array with data to write.
 156:../../core/drivers/octa-flash/src/octa-flash.c ****     * \param    aSize      The number of bytes to be written.
 157:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  The number of written bytes.
 158:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 159:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_SPI_ERROR if something went wrong during SPI communication.
 160:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_LAST_PAGE_WRITTEN if the last block was written and no more data can be buffered.
 161:../../core/drivers/octa-flash/src/octa-flash.c ****     */
 162:../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_write(const uint8_t *apData, const uint32_t aSize)
 163:../../core/drivers/octa-flash/src/octa-flash.c **** {
 164:../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 165:../../core/drivers/octa-flash/src/octa-flash.c **** 
 166:../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_isWriteInProgress())
 167:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 168:../../core/drivers/octa-flash/src/octa-flash.c ****         return E_WRITE_IN_PROGRESS;
 169:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 170:../../core/drivers/octa-flash/src/octa-flash.c **** 
 171:../../core/drivers/octa-flash/src/octa-flash.c ****     if (mCurrentWriteAddress > LAST_FLASH_ADDRESS)
 172:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 173:../../core/drivers/octa-flash/src/octa-flash.c ****         return E_LAST_PAGE_WRITTEN;
 174:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 175:../../core/drivers/octa-flash/src/octa-flash.c **** 
 176:../../core/drivers/octa-flash/src/octa-flash.c ****     uint32_t bytesLeftToWrite = aSize;
 177:../../core/drivers/octa-flash/src/octa-flash.c **** 
 178:../../core/drivers/octa-flash/src/octa-flash.c ****     while (mMemPageIndex + bytesLeftToWrite >= OCTA_FLASH_PAGE_SIZE)
 179:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 180:../../core/drivers/octa-flash/src/octa-flash.c **** 
 181:../../core/drivers/octa-flash/src/octa-flash.c ****         //The number of bytes we will add to mMemBlock in this loop
 182:../../core/drivers/octa-flash/src/octa-flash.c ****         uint32_t bytesToWrite = OCTA_FLASH_PAGE_SIZE - mMemPageIndex;
 183:../../core/drivers/octa-flash/src/octa-flash.c **** 
 184:../../core/drivers/octa-flash/src/octa-flash.c ****         //Filling the remainder of the buffer
 185:../../core/drivers/octa-flash/src/octa-flash.c ****         memcpy(&mMemPage[mMemPageIndex], apData, OCTA_FLASH_PAGE_SIZE);
 186:../../core/drivers/octa-flash/src/octa-flash.c **** 
 187:../../core/drivers/octa-flash/src/octa-flash.c ****         int flushedBytes = OCTA_FLASH_flush();
 188:../../core/drivers/octa-flash/src/octa-flash.c **** 
 189:../../core/drivers/octa-flash/src/octa-flash.c ****         //And writing the block of FLASH_BLOCK_SIZE bytes. This also clears mMemBlock and mMemBlock
 190:../../core/drivers/octa-flash/src/octa-flash.c ****         if (flushedBytes < 0)
 191:../../core/drivers/octa-flash/src/octa-flash.c ****         {
 192:../../core/drivers/octa-flash/src/octa-flash.c ****             //Flush failed
 193:../../core/drivers/octa-flash/src/octa-flash.c ****             printDBG("Flush failed\r\n");
 194:../../core/drivers/octa-flash/src/octa-flash.c ****             return flushedBytes;
 195:../../core/drivers/octa-flash/src/octa-flash.c ****         }
 196:../../core/drivers/octa-flash/src/octa-flash.c **** 
 197:../../core/drivers/octa-flash/src/octa-flash.c ****         //Moving the pointer
 198:../../core/drivers/octa-flash/src/octa-flash.c ****         apData += bytesToWrite;
 199:../../core/drivers/octa-flash/src/octa-flash.c ****         bytesLeftToWrite -= bytesToWrite;
 200:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 201:../../core/drivers/octa-flash/src/octa-flash.c **** 
ARM GAS  /tmp/cckIivDo.s 			page 5


 202:../../core/drivers/octa-flash/src/octa-flash.c ****     if (mCurrentWriteAddress > LAST_FLASH_ADDRESS)
 203:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 204:../../core/drivers/octa-flash/src/octa-flash.c ****         //Flash is full, no more buffering.
 205:../../core/drivers/octa-flash/src/octa-flash.c ****         return E_LAST_PAGE_WRITTEN;
 206:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 207:../../core/drivers/octa-flash/src/octa-flash.c ****     else if (bytesLeftToWrite > 0)
 208:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 209:../../core/drivers/octa-flash/src/octa-flash.c ****         //We still have some bytes left to cache.
 210:../../core/drivers/octa-flash/src/octa-flash.c ****         memcpy(&mMemPage[mMemPageIndex], apData, bytesLeftToWrite);
 211:../../core/drivers/octa-flash/src/octa-flash.c ****         bytesLeftToWrite = 0;
 212:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 213:../../core/drivers/octa-flash/src/octa-flash.c **** 
 214:../../core/drivers/octa-flash/src/octa-flash.c ****     return (aSize-bytesLeftToWrite);
 215:../../core/drivers/octa-flash/src/octa-flash.c **** }
 216:../../core/drivers/octa-flash/src/octa-flash.c **** 
 217:../../core/drivers/octa-flash/src/octa-flash.c **** /**
 218:../../core/drivers/octa-flash/src/octa-flash.c ****     * \brief    Returns the state of the write in process status bit.
 219:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  true is the flash is performing a write action.
 220:../../core/drivers/octa-flash/src/octa-flash.c ****     */
 221:../../core/drivers/octa-flash/src/octa-flash.c **** uint8_t OCTA_FLASH_isWriteInProgress(void)
 222:../../core/drivers/octa-flash/src/octa-flash.c **** {
 223:../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 224:../../core/drivers/octa-flash/src/octa-flash.c ****     uint8_t status = 0;
 225:../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_readReg(SPI_RDSR_CMD, &status) == 0)
 226:../../core/drivers/octa-flash/src/octa-flash.c ****     {

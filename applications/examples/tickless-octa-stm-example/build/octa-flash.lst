 547:../../core/drivers/octa-flash/src/octa-flash.c **** 
 548:../../core/drivers/octa-flash/src/octa-flash.c ****     //send the command over SPI
 549:../../core/drivers/octa-flash/src/octa-flash.c ****     if(HAL_SPI_Transmit(flashSPI, (uint8_t *)txData, index, HAL_MAX_DELAY)!=HAL_OK)
 550:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 551:../../core/drivers/octa-flash/src/octa-flash.c ****         return E_SPI_ERROR;
 552:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 553:../../core/drivers/octa-flash/src/octa-flash.c **** 
 554:../../core/drivers/octa-flash/src/octa-flash.c ****     return 0;

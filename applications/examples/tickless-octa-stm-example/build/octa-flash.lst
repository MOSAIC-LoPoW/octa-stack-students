 123:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 124:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_SPI_ERROR if something went wrong during SPI communication.
 125:../../core/drivers/octa-flash/src/octa-flash.c ****     */
 126:../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_read(uint8_t *apData, const uint32_t aSize)
 127:../../core/drivers/octa-flash/src/octa-flash.c **** {
 128:../../core/drivers/octa-flash/src/octa-flash.c **** 
 129:../../core/drivers/octa-flash/src/octa-flash.c ****     HAL_Delay(SPI_WAIT);
 130:../../core/drivers/octa-flash/src/octa-flash.c **** 
 131:../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_isWriteInProgress())
 132:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 133:../../core/drivers/octa-flash/src/octa-flash.c ****         return E_WRITE_IN_PROGRESS;
 134:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 135:../../core/drivers/octa-flash/src/octa-flash.c **** 
 136:../../core/drivers/octa-flash/src/octa-flash.c ****     //Starting the read.
 137:../../core/drivers/octa-flash/src/octa-flash.c ****     int status = 0;
 138:../../core/drivers/octa-flash/src/octa-flash.c ****     status = OCTA_FLASH_send4BCommand(SPI_READ_4B_CMD, mCurrentReadAddress);
 139:../../core/drivers/octa-flash/src/octa-flash.c ****     if (status!=0)
 140:../../core/drivers/octa-flash/src/octa-flash.c ****     {

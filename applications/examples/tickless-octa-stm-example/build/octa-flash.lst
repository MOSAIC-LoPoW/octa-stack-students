 523:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_WRITE_IN_PROGRESS if the flash is performing a write action.
 524:../../core/drivers/octa-flash/src/octa-flash.c ****     * \returns  E_SPI_ERROR if something went wrong during SPI communication.
 525:../../core/drivers/octa-flash/src/octa-flash.c ****     */
 526:../../core/drivers/octa-flash/src/octa-flash.c **** int OCTA_FLASH_send4BCommand(const uint8_t command, const uint32_t address)
 527:../../core/drivers/octa-flash/src/octa-flash.c **** {
 528:../../core/drivers/octa-flash/src/octa-flash.c **** 
 529:../../core/drivers/octa-flash/src/octa-flash.c ****     if (OCTA_FLASH_isWriteInProgress())
 530:../../core/drivers/octa-flash/src/octa-flash.c ****     {
 531:../../core/drivers/octa-flash/src/octa-flash.c ****         return E_WRITE_IN_PROGRESS;
 532:../../core/drivers/octa-flash/src/octa-flash.c ****     }
 533:../../core/drivers/octa-flash/src/octa-flash.c **** 
 534:../../core/drivers/octa-flash/src/octa-flash.c ****     uint8_t index = 0;
 535:../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = command;
 536:../../core/drivers/octa-flash/src/octa-flash.c **** 
 537:../../core/drivers/octa-flash/src/octa-flash.c ****     //Writing 4 byte address.
 538:../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = (uint8_t)((address >> 24) & 0x000000FF);
 539:../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = (uint8_t)((address >> 16) & 0x000000FF);
 540:../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = (uint8_t)((address >> 8) & 0x000000FF);
 541:../../core/drivers/octa-flash/src/octa-flash.c ****     txData[index++] = (uint8_t)(address & 0x000000FF);
 542:../../core/drivers/octa-flash/src/octa-flash.c **** 
 543:../../core/drivers/octa-flash/src/octa-flash.c ****     //We have to enable SPI here, because isWriteInProgress disables it.

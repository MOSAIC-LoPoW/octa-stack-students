   8:../../core/platform/octa_stm/src/tickless.c **** /*
   9:../../core/platform/octa_stm/src/tickless.c ****  * In this example the tick interrupt is generated by the TIM6 peripheral.
  10:../../core/platform/octa_stm/src/tickless.c ****  * The TIM6 configuration and handling functions are defined in this file.
  11:../../core/platform/octa_stm/src/tickless.c ****  *
  12:../../core/platform/octa_stm/src/tickless.c ****  * When configCREATE_LOW_POWER_DEMO is set to 0 the tick interrupt is
  13:../../core/platform/octa_stm/src/tickless.c ****  * generated by the standard FreeRTOS Cortex-M port layer, which uses the
  14:../../core/platform/octa_stm/src/tickless.c ****  * SysTick timer.
  15:../../core/platform/octa_stm/src/tickless.c ****  */
  16:../../core/platform/octa_stm/src/tickless.c **** /* The frequency at which TIM6 will run. */
  17:../../core/platform/octa_stm/src/tickless.c **** #define lpCLOCK_INPUT_FREQUENCY 	( 1000UL )
  18:../../core/platform/octa_stm/src/tickless.c **** 
  19:../../core/platform/octa_stm/src/tickless.c **** /* This is used to print message on the serial console. */
  20:../../core/platform/octa_stm/src/tickless.c **** #define TICKLESS_DEBUG              DEBUG
  21:../../core/platform/octa_stm/src/tickless.c **** 
  22:../../core/platform/octa_stm/src/tickless.c **** /*-----------------------------------------------------------*/
  23:../../core/platform/octa_stm/src/tickless.c **** 
  24:../../core/platform/octa_stm/src/tickless.c **** /* Calculate how many clock increments make up a single tick period.
  25:../../core/platform/octa_stm/src/tickless.c ****  Since we are using a prescaler equal to 23999, and assuming a clock
  26:../../core/platform/octa_stm/src/tickless.c ****  speed of 48MHz, according the equation [1] in Chapter 11 this
  27:../../core/platform/octa_stm/src/tickless.c ****  period value ensure a timer overflow ever 1ms. 
  28:../../core/platform/octa_stm/src/tickless.c ****  CLOCKFREQ = 8MHz
  29:../../core/platform/octa_stm/src/tickless.c ****  updateevent = 1ms -> 1kHz
ARM GAS  /tmp/ccPyJeoH.s 			page 2


  30:../../core/platform/octa_stm/src/tickless.c **** 
  31:../../core/platform/octa_stm/src/tickless.c ****  updateevent(freq) = Timerfreq/((prescaler+1)(period+1)
  32:../../core/platform/octa_stm/src/tickless.c ****  1k = 8M/((4000)(2)) 
  33:../../core/platform/octa_stm/src/tickless.c **** */
  34:../../core/platform/octa_stm/src/tickless.c **** static const uint32_t ulMaximumPrescalerValue = 3999;
  35:../../core/platform/octa_stm/src/tickless.c **** static const uint32_t ulPeriodValueForOneTick = 1;
  36:../../core/platform/octa_stm/src/tickless.c **** 
  37:../../core/platform/octa_stm/src/tickless.c **** /* Holds the maximum number of ticks that can be suppressed - which is
  38:../../core/platform/octa_stm/src/tickless.c ****  basically how far into the future an interrupt can be generated without
  39:../../core/platform/octa_stm/src/tickless.c ****  loosing the overflow event at all. It is set during initialization. */
  40:../../core/platform/octa_stm/src/tickless.c **** static TickType_t xMaximumPossibleSuppressedTicks = 0;
  41:../../core/platform/octa_stm/src/tickless.c **** 
  42:../../core/platform/octa_stm/src/tickless.c **** /* Flag set from the tick interrupt to allow the sleep processing to know if
  43:../../core/platform/octa_stm/src/tickless.c ****  sleep mode was exited because of an tick interrupt or a different interrupt. */
  44:../../core/platform/octa_stm/src/tickless.c **** static volatile uint8_t ucTickFlag = pdFALSE;
